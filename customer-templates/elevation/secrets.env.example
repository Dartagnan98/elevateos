# orgs/elevation/secrets.env (chmod 600)
# Org-level secrets — keys not per-agent.
# Per-agent Telegram credentials (BOT_TOKEN, CHAT_ID, ALLOWED_USER) live in
# orgs/elevation/agents/<agent>/.env, NOT here. The elevate daemon refuses
# Telegram if those per-agent vars are missing.

# CRM API — used by dashboard adapters and customer-installed outreach skills.
# The config file chooses the secret name, auth mode, base URL, endpoints,
# and message DB column mappings via integrations.crm.
CRM_API_KEY=

# Anthropic — needed by Claude Code PTY runtime if not set system-wide.
ANTHROPIC_API_KEY=

# Gemini — used by graphify and any Gemini-backed skills.
GEMINI_API_KEY=

# Google OAuth (Gmail / Drive) — used by Avery's gmail-doc-router skill.
GMAIL_OAUTH_TOKEN=
